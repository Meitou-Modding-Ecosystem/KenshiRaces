<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Kenshi Races (docs/kenshi-races.md): the races' records, added in the data phase, and the helper dependents add their own races with.
    Built against the game's assemblies, never copied: the game loads them. The fitted bodies in items/races are copied by Play and the release.
  -->

  <PropertyGroup>
    <AssemblyName>KenshiRaces</AssemblyName>
    <RootNamespace>KenshiRaces</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Core/Meitou.Core.csproj" Private="false" />
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Data/Meitou.Data.csproj" Private="false" />
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Simulation/Meitou.Simulation.csproj" Private="false" />
    <ProjectReference Include="$(MeitouEngineDir)src/Meitou.Game/Meitou.Game.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KenshiRaces.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="meitou.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
