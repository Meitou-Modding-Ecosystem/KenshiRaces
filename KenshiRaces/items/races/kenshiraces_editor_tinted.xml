<?xml version="1.0" encoding="UTF-8"?>
<!-- Kenshi Races character editor limits for skin-toned bodies wearing the human head (docs/kenshi-races.md "Character editor"):
     kenshiraces_editor_faces.xml with a Skin Tone slider from the human tones through crimson, purple (the middle, the editor's
     default), plum and indigo to blue-grey. Each colour multiplies the Greenlander head's bare skin, which the body's skin is
     repainted to (docs/race-import.md "Skin tone"), so a colour is the wanted skin over (204, 143, 112). -->
<Editor>
 <Config gender="Male">
  <Category name="Face">
   <Range max="110" min="90" name="Head size" random_variation="10"/>
   <Range max="110" min="90" name="Head shape"/>
   <Range max="150" min="65" mid="100" name="Neck"/>
   <Range max="150" min="70" mid="100" name="Neck width"/>
   <Range max="110" min="90" name="Neck length"/>
   <Range target="wide_cheekbones" target_opposite="narrow_cheekbones" min="-100" mid="0" max="100" name="Cheekbones"/>
   <Range target="big_mouth" min="-100" mid="0" max="100" name="Mouth size"/>
   <Range target="wide_mouth" min="-100" mid="0" max="100" name="Mouth width"/>
   <Range target="wide_nose" min="-100" mid="0" max="100" name="Nose width"/>
   <Range target="long_nose" min="-100" mid="0" max="100" name="Nose length"/>
   <Range target="arch_nose" min="-100" mid="0" max="100" name="Nose arch"/>
   <Range target="high_nose" min="-100" mid="0" max="100" name="Nose position"/>
   <Range target="tiltup_nose" target_opposite="tiltdown_nose" min="-100" mid="0" max="100" name="Nose tilt"/>
   <Range target="high_brow" target_opposite="low_brow" min="-100" mid="0" max="100" name="Brow position"/>
   <Range target="tiltdown_brow" target_opposite="tiltup_brow" min="-100" mid="0" max="100" name="Brow tilt"/>
   <Range target="shallow_eyes" min="-100" mid="0" max="100" name="Eyes depth"/>
   <Range target="narrow_eyes" min="-100" mid="0" max="100" name="Eyes narrow"/>
   <Range target="close_eyes" min="-100" mid="0" max="100" name="Eyes closeness"/>
   <Range target="tiltup_eyes" target_opposite="tiltdown_eyes" min="-100" mid="0" max="100" name="Eyes tilt"/>
   <Range target="high_eyes" min="-100" mid="0" max="100" name="Eyes height"/>
   <Range target="big_eyes" min="-100" mid="0" max="100" name="Eyes size"/>
   <Range target="overbite" target_opposite="underbite" min="-100" mid="0" max="100" name="Chin depth"/>
  </Category>
  <Category name="Body">
   <Range max="120" min="80" name="Height" random_group="0"/>
   <Range max="120" min="80" name="Frame"/>
   <Range max="70" min="0" name="Posture"/>
   <Range max="90" min="45" name="Shoulder set"/>
   <Range max="80" min="25" name="Neck position"/>
   <Range max="115" min="85" name="Leg length" random_group="0"/>
   <Range max="110" min="90" name="Shoulders" random_group="1"/>
   <Range max="145" min="70" name="Arm bulk"/>
   <Range max="120" min="80" name="Hands" random_group="0"/>
   <Range max="120" min="80" name="Feet"/>
   <Range max="150" min="70" mid="100" name="Chest"/>
   <ColourRange name="Skin Tone">
    <Colour r="255" g="255" b="255" />
    <Colour r="251" g="219" b="219" />
    <Colour r="201" g="190" b="180" />
    <Colour r="137" g="119" b="102" />
    <Colour r="188" g="98" b="109" />
    <Colour r="131" g="132" b="232" />
    <Colour r="206" g="143" b="239" />
    <Colour r="88" g="75" b="164" />
    <Colour r="69" g="107" b="228" />
    <Colour r="112" g="178" b="250" />
    <Colour r="75" g="103" b="141" />
   </ColourRange>
  </Category>
 </Config>
 <Config gender="Female">
  <Category name="Face">
   <Range max="110" min="90" name="Head size"/>
   <Range max="110" min="90" name="Head shape"/>
   <Range max="150" min="50" name="Neck"/>
   <Range max="200" min="50" mid="100" name="Neck width"/>
   <Range max="115" min="85" name="Neck length"/>
   <Range target="wide_cheekbones" target_opposite="narrow_cheekbones" min="-100" mid="0" max="100" name="Cheekbones"/>
   <Range target="wide_cheeks" min="-100" mid="0" max="100" name="Cheeks"/>
   <Range target="big_mouth" min="-100" mid="0" max="100" name="Mouth size"/>
   <Range target="wide_mouth" min="-100" mid="0" max="100" name="Mouth width"/>
   <Range target="wide_nose" min="-100" mid="0" max="100" name="Nose width"/>
   <Range target="long_nose" min="-100" mid="0" max="100" name="Nose length"/>
   <Range target="arch_nose" min="-100" mid="0" max="100" name="Nose arch"/>
   <Range target="high_nose" min="-100" mid="0" max="100" name="Nose position"/>
   <Range target="tiltup_nose" target_opposite="tiltdown_nose" min="-100" mid="0" max="100" name="Nose tilt"/>
   <Range target="high_brows" target_opposite="low_brows" min="-100" mid="0" max="100" name="Brow position"/>
   <Range target="tiltdown_brow" target_opposite="tiltup_brow" min="-100" mid="0" max="100" name="Brow tilt"/>
   <Range target="shallow_eyes" min="-100" mid="0" max="100" name="Eyes depth"/>
   <Range target="narrow_eyes" min="-100" mid="0" max="100" name="Eyes narrow"/>
   <Range target="close_eyes" min="-100" mid="0" max="100" name="Eyes closeness"/>
   <Range target="tiltup_eyes" target_opposite="tiltdown_eyes" min="-100" mid="0" max="100" name="Eyes tilt"/>
   <Range target="high_eyes" min="-100" mid="0" max="100" name="Eyes height"/>
   <Range target="big_eyes" min="-100" mid="0" max="100" name="Eyes size"/>
   <Range target="wide_jaw" target_opposite="narrow_jaw" min="-100" mid="0" max="100" name="Jaw"/>
   <Range target="underbite" target_opposite="overbite" min="-100" mid="0" max="100" name="Chin depth"/>
   <Range target="down_chin" target_opposite="up_chin" min="-100" mid="0" max="100" name="Chin height"/>
   <Range target="wide_chin" min="-100" mid="0" max="100" name="Chin width"/>
  </Category>
  <Category name="Body">
   <Range max="120" min="80" name="Height"/>
   <Range max="120" min="80" name="Frame"/>
   <Range max="70" min="0" name="Posture"/>
   <Range max="90" min="45" name="Shoulder set"/>
   <Range max="80" min="25" name="Neck position"/>
   <Range max="120" min="80" mid="100" name="Leg length"/>
   <Range max="110" min="90" name="Shoulders"/>
   <Range max="145" min="70" mid="100" name="Arm bulk"/>
   <Range max="120" min="80" name="Hands"/>
   <Range max="120" min="80" name="Feet"/>
   <Range max="150" min="70" mid="100" name="Chest"/>
   <Range max="150" min="40" mid="85" name="Breast size"/>
   <Range max="130" min="40" mid="100" name="Breast height"/>
   <Range max="120" min="60" mid="100" name="Breast spacing"/>
   <ColourRange name="Skin Tone">
    <Colour r="255" g="255" b="255" />
    <Colour r="251" g="219" b="219" />
    <Colour r="201" g="190" b="180" />
    <Colour r="137" g="119" b="102" />
    <Colour r="188" g="98" b="109" />
    <Colour r="131" g="132" b="232" />
    <Colour r="206" g="143" b="239" />
    <Colour r="88" g="75" b="164" />
    <Colour r="69" g="107" b="228" />
    <Colour r="112" g="178" b="250" />
    <Colour r="75" g="103" b="141" />
   </ColourRange>
  </Category>
 </Config>
</Editor>
